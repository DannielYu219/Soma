{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "titlebar",
  "description": "Allow the local Soma UI to drag and double-click the native titlebar.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": ["core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"]
}
