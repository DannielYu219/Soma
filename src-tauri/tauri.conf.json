{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soma",
  "version": "0.1.2",
  "identifier": "com.soma.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "13.5" },
    "resources": { "../build-resources/": "runtime/" },
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
